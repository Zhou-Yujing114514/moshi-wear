{
  "package": "cn.sswwgzs.moshi.novel",
  "name": "摩柿小说",
  "icon": "/common/images/icon.png",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minAPILevel": 1,
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.fetch" },
    { "name": "system.request" },
    { "name": "system.storage" },
    { "name": "system.file" },
    { "name": "system.prompt" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 336
  },
  "router": {
    "entry": "Shelf",
    "pages": {
      "Login": {
        "component": "login",
        "path": "/login"
      },
      "Shelf": {
        "component": "shelf",
        "path": "/"
      },
      "Search": {
        "component": "search",
        "path": "/search"
      },
      "Reader": {
        "component": "reader",
        "path": "/reader"
      }
    }
  },
  "display": {
    "backgroundColor": "#101318"
  }
}
