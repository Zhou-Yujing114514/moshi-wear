<template>
    <div class="page">
        <img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 336px;height: 102px;" />
        <img static src="/common/images/back.png" @click="back" style="position: absolute;left: 6px;top: 6px;width: 72px;height: 72px;"/>
        <img static src="/common/images/conform.png" @click="save" style="position: absolute;left: 258px;top: 6px;width: 72px;height: 72px;"/>
        <text style="position: absolute;left: 78px;top: 7px;width: 180px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
            {{nowTime}}
        </text>
        <text static style="position: absolute;left: 78px;top: 35px;width: 180px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">
            编辑名称
        </text>

        <div class="input-container">
            <div class="input-display">
                <text static class="input-label">书签名称</text>
                <div class="input-field">
                    <input class="input-text" type="text" value="{{textValue}}" onchange="onTextChange" />
                </div>
            </div>
            <div class="input-counter">
                <text class="counter-text">{{textValue.length}} / 20</text>
            </div>
        </div>
    </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import bookStorage from '../../utils/bookStorage.js'

export default {
    private: {
        textValue: "",
        nowTime: "00:00",
        timer: null
    },
    protected: {
        bookName: '',
        bookmarkIndex: -1,
        currentName: ''
    },

    onInit() {
        this.textValue = this.currentName || '';
        this.updateTime();
        this.timer = setInterval(() => {
            this.updateTime();
        }, 60000);
    },

    onDestroy() {
        if (this.timer) {
            clearInterval(this.timer);
            this.timer = null;
        }
    },

    updateTime() {
        const date = new Date();
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        this.nowTime = `${hours}:${minutes}`;
    },

    onTextChange(e) {
        const v = (e && e.value !== undefined) ? e.value : ((e && e.detail && e.detail.value) || '');
        this.textValue = v.length > 20 ? v.slice(0, 20) : v;
    },

    back() {
        router.back();
    },

    async save() {
        if (!this.textValue) {
            prompt.showToast({ message: '名称不能为空' });
            return;
        }

        try {
            const bookmarks = await bookStorage.getBookmarks(this.bookName);
            if (bookmarks && bookmarks[this.bookmarkIndex]) {
                bookmarks[this.bookmarkIndex].name = this.textValue;
                await bookStorage.setBookmarks(this.bookName, bookmarks);

                prompt.showToast({ message: '保存成功' });
                router.back();
            } else {
                prompt.showToast({ message: '找不到书签' });
            }
        } catch (e) {
            prompt.showToast({ message: '保存失败' });
        }
    }
}
</script>

<style>
@import '../../common/style.css';
.input-container {
    position: absolute;
    top: 100px;
    left: 20px;
    width: 296px;
    flex-direction: column;
}
.input-display {
    width: 100%;
    padding: 20px 24px;
    background-color: #1a1a1a;
    border-radius: 16px;
    border: 2px solid #333333;
    flex-direction: column;
}
.input-label {
    font-size: 24px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.6);
    line-height: 32px;
    margin-bottom: 8px;
}
.input-field {
    width: 100%;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
}
.input-text {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #FFFFFF;
    line-height: 44px;
}
.input-counter {
    width: 100%;
    padding: 8px 4px 0 4px;
    align-items: flex-end;
}
.counter-text {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 28px;
}
</style>
