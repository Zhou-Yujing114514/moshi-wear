  同样以 AGPL-3.0 开源（见仓库根目录 LICENSE 与 NOTICE）。品牌名仍为「摩柿小说」。
-->
<template>
	<div class="page">
    <scroll scroll-y="{{true}}" bounces="{{true}}" style="position: absolute;width: 336px;height: 480px;">
      <img static src="/common/images/app_about.png" style="width: 100%;"/>

      <text style="position: absolute;left: 26px;top: 102px;width: 282px;height: 48px;font-size: 36px;font-weight: bold;color: #FFFFFF;">
        {{appName}}
      </text>
      <text style="position: absolute;left: 26px;top: 144px;width: 204px;height: 48px;font-size: 36px;font-weight: bold;color: rgba(255, 255, 255, 0.6);">
        {{displayVersion}}
      </text>
      <text style="position: absolute;left: 26px;top: 186px;width: 282px;height: 36px;font-size: 24px;font-weight: bold;color: rgba(255, 255, 255, 0.4);">
        {{versionType}}
      </text>
      <text style="position: absolute;left: 26px;top: 240px;width: 284px;font-size: 20px;line-height: 30px;color: rgba(255, 255, 255, 0.7);">
        {{aboutText}}
      </text>
    </scroll>
    <img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 336px;height: 102px;" />
    <text style="position: absolute;left: 78px;top: 7px;width: 180px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">{{nowTime}}</text>
    <text static style="position: absolute;left: 78px;top: 35px;width: 180px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">关于</text>
    <img static src="/common/images/back.png" @click="back" style="position: absolute;left: 6px;top: 6px;width: 72px;height: 72px;"/>
	</div>
</template>

<script>
  import router from '@system.router'
  import app from '@system.app'
  import storage from '../../utils/storage.js'

  export default {
    private: {
      nowTime: ':',
      appName: '摩柿小说',
      appVer: '2.0.0',
      displayVersion: '2.0.0',
      versionType: '小米手环 Vela 快应用',
      aboutText: '本应用为小米手环 Vela 快应用，本地阅读引擎移植自 AGPL-3.0 开源项目「弦电子书」（https://github.com/youshen2/com.bandbbs.ebook），摩柿小说同样以 AGPL-3.0 开源；保留原作者版权。',
      timer: null,
      timeFormat: '24h'
    },

    onInit() {
      this.loadTimeFormat();
      const that = this;
      this.timer = setInterval(function(){
        that.updateTime();
      }, 60000);
      this.appName = app.getInfo().name;
      this.appVer = app.getInfo().versionName;
      this.parseVersion();
    },

    onShow() {
      this.updateTime();
    },

    onDestroy() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    },

    back() {
      router.back();
    },

    loadTimeFormat() {
      storage.get({
        key: 'EBOOK_TIME_FORMAT',
        success: (data) => {
          if (data) {
            this.timeFormat = data;
          }
          this.updateTime();
        },
        fail: () => {
          this.updateTime();
        }
      });
    },

    updateTime() {
      const date = new Date();
      let hours = date.getHours();
      let minutes = date.getMinutes();
      if (this.timeFormat === '12h') {
        let ampm = hours >= 12 ? '下午' : '上午';
        hours = hours % 12;
        hours = hours ? hours : 12;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        this.nowTime = `${ampm} ${hours}:${minutes}`;
      } else {
        hours = hours < 10 ? '0' + hours : hours;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        this.nowTime = `${hours}:${minutes}`;
      }
    },

    parseVersion() {
      // 摩柿小说：版本号直接取自 manifest（versionName = 2.0.0）
      this.displayVersion = this.appVer;
      this.versionType = '小米手环 Vela 快应用';
    }
  }
</script>

<style>
  @import '../../common/style.css';
</style>
